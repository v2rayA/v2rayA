#!/sbin/openrc-run
# Copyright 2021 Gentoo Authors
# Distributed under the terms of the GNU General Public License v2

name="v2rayA"
description="Web client for its own Xray-based core, with transparent proxy"
command="/usr/bin/v2raya"
command_args="${V2RAYA_OPTS}"
error_log="/var/log/v2raya/error.log"
# supervise-daemon keeps the process in its own cgroup and process group:
# a stop takes the core with it, a crash restarts the service.
supervisor="supervise-daemon"
respawn_delay=5
respawn_max=0
rc_ulimit="-n 30000"
rc_cgroup_cleanup="yes"
# The service stops its core and removes the transparent-proxy rules on
# SIGTERM; give it time before OpenRC escalates, or the rules stay behind.
retry="TERM/30/KILL/5"

depend() {
	need net
	use dns firewall
	after net firewall nftables iptables
}

start_pre() {
	checkpath -d -m 0755 /var/log/v2raya
	checkpath -d -m 0750 /etc/v2raya
}
